# PostgreSQL connection required: initialize local settings with scripts/init-local-env.py,
# or fill in the remote database connection below.
# Prefer separate fields; passwords may contain special characters without URL encoding.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=quarkmed
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PGSSLROOTCERT=
DATABASE_SCHEMA=quarkmed
BROKER_URL=redis://localhost:6387/0
TOOL_URL=http://localhost:8012
TOOL_SECRET=quark-local-tools-change-me
STORAGE_ROOT=./data/assets
WEB_ORIGIN=http://localhost:5174
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO=false
# Optional dedicated stable secret for model credentials; falls back to TOOL_SECRET.
MODEL_ENCRYPTION_KEY=
MODEL_SUPPORTS_IMAGES=false
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
CALQUE_ENABLED=false
# Optional outbound HTTP proxy for known HTML export CDNs (images/fonts only).
IMPORT_RESOURCE_PROXY=
# Optional local PostgreSQL (enable local-db profile). For containerized API set DOCKER_PGHOST=db, DOCKER_PGPORT=5432.
DOCKER_PGHOST=
DOCKER_PGPORT=
LOCAL_POSTGRES_PASSWORD=

# Enterprise WeChat self-built application. Secret is server-side only.
WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_URL=https://your-domain.example/api/auth/wecom/callback
# Optional bootstrap mapping, imported explicitly on the server. Preserve roles/projects.
WECOM_USER_BINDINGS=[]
# Default deployed runtime keeps password login disabled. scripts/dev.sh enables local mode.
APP_ENV=production
LOCAL_SYSTEM_LOGIN=false
# Temporary public system-password login; use only while WeCom OAuth is not ready.
PUBLIC_SYSTEM_LOGIN=false
