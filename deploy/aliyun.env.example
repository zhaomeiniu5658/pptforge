# Copy this file to .env on the ECS host and fill every required value.
# Keep this file mode 600. Never commit the filled .env.

# Alibaba Cloud RDS PostgreSQL private endpoint.
PGHOST=your-rds-private-endpoint.pg.rds.aliyuncs.com
PGPORT=1921
PGDATABASE=quarkmed
PGUSER=quarkmed_app
PGPASSWORD=replace-with-a-long-random-password
PGSSLMODE=require
PGSSLROOTCERT=
DATABASE_SCHEMA=quarkmed

# The Compose overlay keeps Valkey private on the ECS host.
DOCKER_PGHOST=${PGHOST}
DOCKER_PGPORT=${PGPORT}
BROKER_URL=redis://queue:6379/0
TOOL_URL=http://tools:8012
STORAGE_ROOT=/data/assets
TOOL_SECRET=replace-with-a-long-random-secret

# Use the public domain after DNS points to the ECS or an Alibaba Cloud ALB.
WEB_ORIGIN=https://ppt.example.com
COOKIE_SECURE=true
WEB_BIND_PORT=80

# Set this only for the first initialization. Remove it after the first login.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_DEMO=false

# Optional model configuration. Keep API keys on the server only.
MODEL_ENCRYPTION_KEY=replace-with-another-long-random-secret
MODEL_SUPPORTS_IMAGES=false
MODEL_PROVIDER=openai
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
CALQUE_ENABLED=false
IMPORT_RESOURCE_PROXY=

