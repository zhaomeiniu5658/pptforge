{
  "name": "calque",
  "version": "1.0.0",
  "description": "Turn a screenshot of a website into working HTML and CSS. Measures the image; does not guess at it.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "calque": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:unit": "node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "calque": "node dist/src/cli.js",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
